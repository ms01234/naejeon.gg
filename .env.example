# 웹 (Next.js / Vercel)
# - 브라우저·클라이언트 컴포넌트에서 Supabase 접근 시 URL·키는 반드시 NEXT_PUBLIC_* 여야 합니다.
# - service_role 키는 절대 NEXT_PUBLIC_ 로 두지 말 것 (봇/서버에서만 SUPABASE_SERVICE_ROLE_KEY 사용).
# 권장: 배포 도메인(OG·metadataBase·openGraph.url). 비우면 https://naejeon-gg.vercel.app 기본
NEXT_PUBLIC_SITE_URL=
# 선택: 봇이 전적 저장 후 /ranking 을 즉시 갱신할 때 사용. 비우면 NEXT_PUBLIC_SITE_URL 로 POST
RANKING_REVALIDATE_BASE_URL=
# 위 revalidate API 보호용. Next(Vercel)와 봇 양쪽에 동일 값 설정
REVALIDATE_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 디스코드 봇 (로컬/별도 호스트, 절대 클라이언트에 넣지 말 것)
DISCORD_BOT_TOKEN=
# Application ID (= OAuth2 "CLIENT ID" 와 동일). register.js 는 DISCORD_CLIENT_ID 만 있어도 동작합니다.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
# 선택: 길드에만 슬래시 명령 등록(빠른 반영)
DISCORD_GUILD_ID=

# 봇 전용 — Supabase 대시보드 service_role (RLS 우회 삽입)
SUPABASE_SERVICE_ROLE_KEY=