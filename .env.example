# 웹 (Next.js / Vercel)
# - 브라우저·클라이언트 컴포넌트에서 Supabase 접근 시 URL·키는 반드시 NEXT_PUBLIC_* 여야 합니다.
# - service_role 키는 절대 NEXT_PUBLIC_ 로 두지 말 것 (봇/서버에서만 SUPABASE_SERVICE_ROLE_KEY 사용).
# 선택: 배포 도메인(OG/절대 URL). 비우면 로컬 기본값 사용
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 디스코드 봇 (로컬/별도 호스트, 절대 클라이언트에 넣지 말 것)
DISCORD_BOT_TOKEN=
# Application ID (= OAuth2 "CLIENT ID" 와 동일). register.js 는 DISCORD_CLIENT_ID 만 있어도 동작합니다.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
# 선택: 길드에만 슬래시 명령 등록(빠른 반영)
DISCORD_GUILD_ID=
# 아래 역할 ID들은 현재 봇 라우터에서 사용하지 않습니다. 권한은 서버 역할 이름 **관리자** 또는 Discord **Administrator** 로만 검사합니다.
DISCORD_RECORDER_ROLE_ID=
DISCORD_MATCH_DELETE_ROLE_ID=

# 봇 전용 — Supabase 대시보드 service_role (RLS 우회 삽입)
SUPABASE_SERVICE_ROLE_KEY=